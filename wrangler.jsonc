{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scripture",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-05",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash",
    // The Worker answers page routes; files are served directly.
    "run_worker_first": [
      "/*",
      "!/data/*",
      "!/text/*",
      "!/src/*",
      "!/shared/*",
      "!/fonts/*",
      "!/*.js",
      "!/*.css",
      "!/*.html",
      "!/*.json",
      "!/*.xml",
      "!/*.txt",
      "!/*.ico",
      "!/*.svg",
      "!/*.png"
    ]
  }
}
