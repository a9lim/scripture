{
  "chapter": 111,
  "id": "quran-111",
  "name": "Flame",
  "sections": [
    {
      "startVerse": 1,
      "verses": [
        {
          "number": 1,
          "text": "The power of Abi-Lahav will perish, and he will perish."
        },
        {
          "number": 2,
          "text": "His wealth and gains will not exempt him."
        },
        {
          "number": 3,
          "text": "He will be plunged in flaming Fire,"
        },
        {
          "number": 4,
          "text": "And his wife, the wood-carrier,"
        },
        {
          "number": 5,
          "text": "Will have upon her neck a halter of palm-fibre."
        }
      ]
    }
  ]
}